# Docker Compose demo configuration.
# Replace every "replace-with-..." value before using this outside a disposable local demo.
# Generate secrets with: openssl rand -hex 32

NEW_API_IMAGE=calciumion/new-api:latest
NEW_API_PORT=3000
TZ=Asia/Shanghai
DEFAULT_LANGUAGE=zh-CN
NODE_NAME=new-api-demo-1

POSTGRES_USER=new_api
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password
POSTGRES_DB=new_api

REDIS_PASSWORD=replace-with-a-strong-redis-password

# Keep these values persistent across container restarts and identical on all nodes.
SESSION_SECRET=replace-with-a-persistent-random-session-secret
CRYPTO_SECRET=replace-with-a-persistent-random-crypto-secret

ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=true

# Local HTTP demo only. Do not expose this mode to the public internet.
SESSION_COOKIE_SECURE=false
TRUSTED_PROXIES=none

# For production HTTPS, set SESSION_COOKIE_SECURE=true and uncomment the exact
# public HTTPS origin below. Do not use wildcards or include a path.
# SESSION_COOKIE_TRUSTED_URL=https://panel.example.com
